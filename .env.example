# Copy to .env and fill in.
#
# The anon (publishable) key is SAFE to ship in a browser bundle — it carries no
# privileges of its own. Everything it can read is decided by the row-level
# security policies on the database. v1 grants it SELECT only, on content tables
# only. Never put SUPABASE_SERVICE_ROLE_KEY in this file: the service role
# bypasses RLS entirely and would expose full read/write to anyone who opened
# devtools.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
